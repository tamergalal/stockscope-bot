# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=put_your_botfather_token_here

# Financial Modeling Prep API key (optional — free tier at site.financialmodelingprep.com)
FMP_API_KEY=

# Database (default: local SQLite file)
DATABASE_URL=sqlite:///stock_bot.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# /cheap command default price caps (can also be overridden per-command, e.g. /cheap egx 30)
CHEAP_MAX_PRICE_EGX=50
CHEAP_MAX_PRICE_US=10

# --- Deployment ---
# "polling" for local PC / VPS (default), "webhook" for Render/Koyeb free tiers
MODE=polling
# Required only when MODE=webhook — your public service URL (no trailing slash)
WEBHOOK_URL=
# Port is auto-injected by cloud platforms (Render/Koyeb); default 8080 locally
PORT=8080
